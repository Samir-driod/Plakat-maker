{
  "name": "plakat-maker",
  "productName": "Plakat Maker",
  "version": "1.0.0",
  "description": "Tworzenie plakatów na ekran w poziomie i pionie",
  "author": "Plakat Maker",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "start": "node build.mjs && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node build.mjs && playwright test",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "node build.mjs && electron-builder --win portable nsis"
  },
  "build": {
    "appId": "pl.plakatmaker.app",
    "productName": "Plakat Maker",
    "copyright": "Plakat Maker",
    "directories": { "output": "release", "buildResources": "build" },
    "files": [
      "package.json",
      "electron/**",
      "src/index.html",
      "src/present.html",
      "src/core/**",
      "dist/**",
      "!**/*.map"
    ],
    "fileAssociations": [
      { "ext": "plakat", "name": "Projekt Plakat Maker", "description": "Projekt plakatu", "role": "Editor", "icon": "build/icon.png" }
    ],
    "win": { "target": ["portable", "nsis"], "icon": "build/icon.png" },
    "portable": { "artifactName": "PlakatMaker-${version}-portable.exe" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Plakat Maker",
      "artifactName": "PlakatMaker-${version}-instalator.exe"
    }
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/raleway": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@playwright/test": "1.64.1",
    "electron": "45.2.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "jspdf": "4.2.1",
    "konva": "10.9.0",
    "qrcode": "1.5.4",
    "vitest": "5.0.5"
  }
}
